---
interface Props {
  href: string;
  title: string;
  excerpt?: string;
  date: Date;
  tags?: string[];
  coverImage?: string;
  readingTime?: number;
}

const { href, title, excerpt, date, tags = [], coverImage, readingTime } = Astro.props;

const day = date.toLocaleDateString('id-ID', { day: 'numeric' });
const monthYear = date.toLocaleDateString('id-ID', { month: 'short', year: 'numeric' });
---

<a href={href} class="group grid grid-cols-[3.5rem_1fr] sm:grid-cols-[4.5rem_7rem_1fr] gap-4 sm:gap-6 py-6 border-b border-line items-start">
  <div class="pt-1">
    <p class="font-display text-xl leading-none text-ink">{day}</p>
    <p class="text-xs text-muted mt-1 uppercase tracking-wide">{monthYear}</p>
  </div>

  <div class="hidden sm:block aspect-[4/3] overflow-hidden bg-surface rounded-sm">
    {
      coverImage ? (
        <img
          src={coverImage}
          alt=""
          class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-300"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center">
          <span class="font-display text-3xl text-ink/15">{title.charAt(0)}</span>
        </div>
      )
    }
  </div>

  <div class="min-w-0">
    <h3 class="font-display text-lg sm:text-xl leading-snug text-ink group-hover:text-orange transition-colors">
      {title}
    </h3>
    {excerpt && <p class="mt-1.5 text-sm text-muted leading-relaxed">{excerpt}</p>}
    <div class="mt-3 flex flex-wrap items-center gap-2">
      {
        tags.map((tag) => (
          <span class="text-xs px-2 py-0.5 bg-honey/25 text-ink/80 rounded-sm">{tag}</span>
        ))
      }
      {readingTime && <span class="text-xs text-muted/70">{readingTime} menit baca</span>}
    </div>
  </div>
</a>
