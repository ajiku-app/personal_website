---
interface Props {
  href: string;
  title: string;
  description: string;
  role?: string;
  tags?: string[];
  coverImage?: string;
}

const { href, title, description, role, tags = [], coverImage } = Astro.props;
---

<a href={href} class="group block">
  <div class="aspect-[4/3] bg-surface rounded-sm overflow-hidden mb-4 flex items-center justify-center border border-line">
    {
      coverImage ? (
        <img
          src={coverImage}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
        />
      ) : (
        <span class="font-display text-4xl text-ink/15">{title.charAt(0)}</span>
      )
    }
  </div>
  {role && <p class="text-xs uppercase tracking-wide text-orange mb-1.5">{role}</p>}
  <h3 class="font-display text-lg leading-snug text-ink group-hover:text-orange transition-colors">
    {title}
  </h3>
  <p class="mt-1.5 text-sm text-muted leading-relaxed">{description}</p>
  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="text-xs px-2 py-0.5 bg-ink/5 text-ink/70 rounded-sm">{tag}</span>
        ))}
      </div>
    )
  }
</a>
