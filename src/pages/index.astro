---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../lib/utils';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const postsWithReadingTime = allPosts.map((post) => ({
  post,
  readingTime: getReadingTime(post.body),
}));

const allPortfolio = (await getCollection('portfolio'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<BaseLayout title="Beranda">
  <section class="relative overflow-hidden border-b border-line">
    <div class="absolute -left-2 top-10 grid grid-cols-3 gap-2 opacity-60 hero-fade" aria-hidden="true">
      {Array.from({ length: 9 }).map(() => (
        <span class="w-1 h-1 rounded-full bg-orange/60"></span>
      ))}
    </div>
    <div class="absolute right-0 bottom-0 grid grid-cols-5 gap-2 opacity-40 pr-6 pb-6 hero-fade" aria-hidden="true">
      {Array.from({ length: 20 }).map(() => (
        <span class="w-1 h-1 rounded-full bg-ink/40"></span>
      ))}
    </div>

    <div class="max-w-4xl mx-auto px-5 sm:px-8 pt-12 sm:pt-16 pb-14 grid sm:grid-cols-[1.15fr_0.85fr] gap-10 sm:gap-8 items-center relative">
      <div>
        <p class="hero-in hero-in-1 text-orange text-sm mb-3 tracking-wide uppercase">Menulis · Portofolio · Jurnal</p>
        <h1 class="hero-in hero-in-2 font-display text-3xl sm:text-5xl leading-[1.1] text-ink">
          Halo, saya <span class="relative inline-block text-orange">
            menulis
            <svg class="absolute left-0 -bottom-1 w-full hero-wiggle" height="6" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
              <path d="M0 3 Q 25 0, 50 3 T 100 3" fill="none" stroke="currentColor" stroke-width="2" />
            </svg>
          </span>,
          membangun, dan mencatat prosesnya di sini.
        </h1>
        <p class="hero-in hero-in-3 mt-4 text-base sm:text-lg text-muted max-w-xl leading-relaxed">
          Ruang pribadi tempat saya membagikan tulisan, memajang pekerjaan yang pernah
          saya kerjakan, dan menyimpan catatan harian yang lebih santai.
        </p>
        <div class="hero-in hero-in-4 mt-6 flex flex-wrap gap-4">
          <a
            href="/tulisan"
            class="bg-orange text-navy font-medium px-5 py-2.5 rounded-sm text-sm hover:bg-orangeLight hover:-translate-y-0.5 transition-all"
          >
            Baca tulisan terbaru
          </a>
          <a
            href="/portofolio"
            class="border border-ink/20 text-ink px-5 py-2.5 rounded-sm text-sm hover:border-orange hover:text-orange hover:-translate-y-0.5 transition-all"
          >
            Lihat portofolio
          </a>
        </div>

        <div class="hero-in hero-in-5 mt-6 flex items-center gap-3">
          <a
            href="https://www.linkedin.com/in/dwi-septa-aji-9bb10411b/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-9 h-9 rounded-full border border-line flex items-center justify-center text-muted hover:border-orange hover:text-orange hover:-translate-y-0.5 transition-all"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4V23h-4V8zm7 0h3.8v2.05h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1V23h-4v-6.86c0-1.64-.03-3.75-2.29-3.75-2.29 0-2.64 1.79-2.64 3.63V23h-4V8z"/></svg>
          </a>
          <a
            href="https://github.com/ajiku-app"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="w-9 h-9 rounded-full border border-line flex items-center justify-center text-muted hover:border-orange hover:text-orange hover:-translate-y-0.5 transition-all"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1-.02-1.96-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.42.36.78 1.07.78 2.16 0 1.56-.01 2.82-.01 3.2 0 .31.2.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          </a>
          <a
            href="mailto:septa.aji.sisworo@gmail.com"
            aria-label="Email"
            class="w-9 h-9 rounded-full border border-line flex items-center justify-center text-muted hover:border-orange hover:text-orange hover:-translate-y-0.5 transition-all"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 5h20v14H2z"/><path d="M2 6l10 8 10-8"/></svg>
          </a>
        </div>
      </div>

      <div class="hero-in hero-in-3 relative flex justify-center sm:justify-end" aria-hidden="false">
        <div class="absolute -left-2 -top-2 grid grid-cols-3 gap-1.5 opacity-70 z-0" aria-hidden="true">
          {Array.from({ length: 9 }).map(() => (
            <span class="w-1 h-1 rounded-full bg-orange"></span>
          ))}
        </div>

        <div class="relative w-48 h-48 sm:w-60 sm:h-60 hero-float">
          <div class="absolute inset-0 rounded-full border-2 border-orange/70"></div>
          <div class="absolute inset-3 rounded-full overflow-hidden bg-surface2">
            <img
              src="/images/profile.jpg"
              onerror="this.onerror=null;this.src='/images/profile-placeholder.svg'"
              alt="Foto profil Dwi Septa Aji S"
              class="w-full h-full object-cover"
            />
          </div>
          <span class="relative">
            <span class="absolute bottom-3 right-3 w-5 h-5 rounded-full bg-orange border-4 border-navy text-orange hero-pulse"></span>
            <span class="absolute bottom-3 right-3 w-5 h-5 rounded-full bg-orange border-4 border-navy"></span>
          </span>
        </div>

        <div class="absolute -right-3 -bottom-3 grid grid-cols-4 gap-1.5 opacity-40 z-0" aria-hidden="true">
          {Array.from({ length: 12 }).map(() => (
            <span class="w-1 h-1 rounded-full bg-ink"></span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="reveal max-w-4xl mx-auto px-5 sm:px-8 py-8 grid sm:grid-cols-3 gap-4">
    <a href="/tulisan" class="bg-surface border border-line rounded-sm p-5 hover:border-orange/50 transition-colors group">
      <p class="text-orange text-xs uppercase tracking-wide mb-2">Menulis</p>
      <p class="text-ink font-medium group-hover:text-orange transition-colors">Artikel & pemikiran</p>
    </a>
    <a href="/portofolio" class="bg-surface border border-line rounded-sm p-5 hover:border-orange/50 transition-colors group">
      <p class="text-orange text-xs uppercase tracking-wide mb-2">Portofolio</p>
      <p class="text-ink font-medium group-hover:text-orange transition-colors">Pekerjaan & proyek</p>
    </a>
    <a href="/jurnal" class="bg-surface border border-line rounded-sm p-5 hover:border-orange/50 transition-colors group">
      <p class="text-orange text-xs uppercase tracking-wide mb-2">Jurnal</p>
      <p class="text-ink font-medium group-hover:text-orange transition-colors">Catatan personal</p>
    </a>
  </section>

  <section class="reveal max-w-4xl mx-auto px-5 sm:px-8 py-10 border-t border-line">
    <div class="flex items-end justify-between mb-2">
      <h2 class="font-display text-xl sm:text-2xl text-ink">Tulisan terbaru</h2>
      <a href="/tulisan" class="text-sm text-orange hover:underline underline-offset-2">
        Lihat semua
      </a>
    </div>
    <div>
      {
        postsWithReadingTime.map(({ post, readingTime }) => (
          <PostCard
            href={`/tulisan/${post.slug}`}
            title={post.data.title}
            excerpt={post.data.description}
            date={post.data.pubDate}
            tags={post.data.tags}
            coverImage={post.data.coverImage}
            readingTime={readingTime}
          />
        ))
      }
    </div>
  </section>

  <section class="reveal max-w-4xl mx-auto px-5 sm:px-8 py-10 border-t border-line">
    <div class="flex items-end justify-between mb-6">
      <h2 class="font-display text-xl sm:text-2xl text-ink">Pekerjaan terpilih</h2>
      <a href="/portofolio" class="text-sm text-orange hover:underline underline-offset-2">
        Lihat semua
      </a>
    </div>
    <div class="reveal-stagger grid sm:grid-cols-2 gap-8">
      {
        allPortfolio.map((item) => (
          <PortfolioCard
            href={`/portofolio/${item.slug}`}
            title={item.data.title}
            description={item.data.description}
            role={item.data.role}
            tags={item.data.tags}
            coverImage={item.data.coverImage}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
