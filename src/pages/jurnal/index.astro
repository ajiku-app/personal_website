---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JournalEntryCard from '../../components/JournalEntryCard.astro';
import { getCollection } from 'astro:content';
import { getSnippet } from '../../lib/utils';

const entries = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Jurnal" description="Catatan personal yang lebih santai, ditulis apa adanya.">
  <section class="max-w-4xl mx-auto px-5 sm:px-8 pt-12 pb-16">
    <div class="flex items-end justify-between gap-4 mb-2">
      <h1 class="font-display text-3xl sm:text-4xl text-ink">Jurnal</h1>
      <p class="text-sm text-muted/70 whitespace-nowrap">{entries.length} catatan</p>
    </div>
    <p class="text-muted max-w-xl mb-8">
      Catatan yang lebih personal — bukan artikel yang dipikirkan matang-matang, lebih ke
      potongan hari yang ingin saya simpan.
    </p>

    {
      entries.length === 0 ? (
        <p class="text-muted py-10">Belum ada catatan jurnal.</p>
      ) : (
        <div class="reveal-stagger">
          {entries.map((entry) => (
            <JournalEntryCard
              href={`/jurnal/${entry.slug}`}
              title={entry.data.title}
              date={entry.data.pubDate}
              mood={entry.data.mood}
              snippet={getSnippet(entry.body)}
            />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
