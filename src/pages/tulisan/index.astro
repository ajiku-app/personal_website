---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../lib/utils';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured, ...rest] = allPosts;

const featuredReadingTime = featured ? getReadingTime(featured.body) : 0;
const restWithReadingTime = rest.map((post) => ({
  post,
  readingTime: getReadingTime(post.body),
}));

const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

const featuredDate = featured?.data.pubDate.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title="Tulisan" description="Kumpulan artikel dan pemikiran yang saya tulis.">
  <section class="max-w-4xl mx-auto px-5 sm:px-8 pt-12 pb-16">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-4">
      <div>
        <h1 class="font-display text-3xl sm:text-4xl mb-2 text-ink">Tulisan</h1>
        <p class="text-muted max-w-xl">
          Artikel dan pemikiran yang saya tulis lebih hati-hati — soal pekerjaan, proses belajar,
          dan hal-hal yang sedang saya pikirkan.
        </p>
      </div>
      <p class="text-sm text-muted/70 whitespace-nowrap">{allPosts.length} tulisan</p>
    </div>

    {
      allTags.length > 0 && (
        <div id="tag-filter" class="flex flex-wrap gap-2 mt-6">
          <button
            data-tag="all"
            class="tag-btn text-xs px-3 py-1.5 rounded-full border border-honey bg-honey text-ink transition-colors"
          >
            Semua
          </button>
          {allTags.map((tag) => (
            <button
              data-tag={tag}
              class="tag-btn text-xs px-3 py-1.5 rounded-full border border-line text-muted hover:border-honey hover:text-ink transition-colors"
            >
              {tag}
            </button>
          ))}
        </div>
      )
    }

    {
      featured && (
        <a
          href={`/tulisan/${featured.slug}`}
          class="group grid sm:grid-cols-2 gap-6 sm:gap-8 items-center mt-8 mb-4 pb-8 border-b-2 border-orange/40"
        >
          <div class="aspect-[4/3] overflow-hidden bg-surface rounded-sm order-1 sm:order-2">
            {featured.data.coverImage ? (
              <img
                src={featured.data.coverImage}
                alt=""
                class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <span class="font-display text-5xl text-ink/15">{featured.data.title.charAt(0)}</span>
              </div>
            )}
          </div>
          <div class="order-2 sm:order-1">
            <p class="text-xs uppercase tracking-wide text-orange mb-3">Tulisan terbaru</p>
            <h2 class="font-display text-2xl sm:text-3xl leading-tight text-ink group-hover:text-orange transition-colors">
              {featured.data.title}
            </h2>
            <p class="mt-3 text-muted leading-relaxed">{featured.data.description}</p>
            <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-muted/70">
              <span>{featuredDate}</span>
              <span>·</span>
              <span>{featuredReadingTime} menit baca</span>
            </div>
          </div>
        </a>
      )
    }

    {
      restWithReadingTime.length === 0 && !featured ? (
        <p class="text-muted py-10">Belum ada tulisan. Kembali lagi nanti.</p>
      ) : (
        <div id="post-list" class="reveal-stagger">
          {restWithReadingTime.map(({ post, readingTime }) => (
            <div class="post-item" data-tags={post.data.tags.join(',')}>
              <PostCard
                href={`/tulisan/${post.slug}`}
                title={post.data.title}
                excerpt={post.data.description}
                date={post.data.pubDate}
                tags={post.data.tags}
                coverImage={post.data.coverImage}
                readingTime={readingTime}
              />
            </div>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const items = document.querySelectorAll<HTMLDivElement>('.post-item');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag;

      buttons.forEach((b) => {
        b.classList.remove('bg-honey', 'border-honey', 'text-ink');
        b.classList.add('border-line', 'text-muted');
      });
      btn.classList.add('bg-honey', 'border-honey', 'text-ink');
      btn.classList.remove('border-line', 'text-muted');

      items.forEach((item) => {
        const tags = item.dataset.tags?.split(',') ?? [];
        const show = tag === 'all' || tags.includes(tag ?? '');
        item.style.display = show ? '' : 'none';
      });
    });
  });
</script>
